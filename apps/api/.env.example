# Pushr API Environment Variables
PORT=3000
MONGODB_URI=mongodb://localhost:27017/pushr
JWT_SECRET=replace_with_a_secure_random_secret_in_production
REGISTRY_HOST_INTERNAL=k3d-pushr-registry:5000
REGISTRY_HOST_EXTERNAL=localhost:5001
API_INTERNAL_URL=http://host.k3d.internal:3000
KUBECONFIG=
BUILDS_NAMESPACE=pushr-builds
MAX_CONCURRENT_BUILDS=2
BUILD_TIMEOUT_SECONDS=600
REPOS_PATH=/repos
